+    @classmethod
+    def _from_series(cls, series: EagerSeriesT) -> Self:
+        return cls(
+            lambda _df: [series],
+            evaluate_output_names=lambda _df: [series.name],
+            alias_output_names=None,
+            implementation=series._implementation,
+            version=series._version,
+        )
