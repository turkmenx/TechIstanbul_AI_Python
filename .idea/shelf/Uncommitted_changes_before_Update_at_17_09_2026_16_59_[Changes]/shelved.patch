+    def test_swapaxes(self):
+        a = np.arange(1 * 2 * 3 * 4).reshape(1, 2, 3, 4).copy()
+        idx = np.indices(a.shape)
+        assert_(a.flags['OWNDATA'])
+        b = a.copy()
+        # check exceptions
+        assert_raises(AxisError, a.swapaxes, -5, 0)
