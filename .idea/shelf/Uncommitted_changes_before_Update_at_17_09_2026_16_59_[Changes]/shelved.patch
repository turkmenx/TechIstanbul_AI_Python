+                ExprNode(
+                    ExprKind.ELEMENTWISE,
+                    "__or__",
+                    exprs=(other,),
+                    str_as_lit=True,
+                    allow_multi_output=True,
+                )
+            )
+        return self._to_expr()._append_node(
+            ExprNode(ExprKind.ELEMENTWISE, "__or__", exprs=(other,), str_as_lit=True)
+        )
+
+    def __and__(self, other: Any) -> Expr:  # type: ignore[override]
