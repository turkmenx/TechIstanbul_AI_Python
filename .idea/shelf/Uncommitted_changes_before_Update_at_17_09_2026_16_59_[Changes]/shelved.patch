+    def assert_partitioned(self, d, kth):
+        prev = 0
+        for k in np.sort(kth):
+            assert_array_compare(operator.__le__, d[prev:k], d[k],
+                    err_msg=f'kth {k}')
+            assert_((d[k:] >= d[k]).all(),
+                    msg=f"kth {k}, {d[k:]!r} not greater equal {d[k]!r}")
+            prev = k + 1
