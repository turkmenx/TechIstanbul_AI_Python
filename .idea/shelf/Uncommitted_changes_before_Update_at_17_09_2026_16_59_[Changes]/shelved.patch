+    --------
+    >>> import numpy as np
+    >>> np.linalg._umath_linalg.det.signature
+    '(m,m)->()'
+    >>> np.matmul.signature
+    '(n?,k),(k,m?)->(n?,m?)'
+    >>> np.add.signature is None
