+class TestGenpareto:
+    def test_ab(self):
+        # c >= 0: a, b = [0, inf]
+        for c in [1., 0.]:
+            c = np.asarray(c)
+            a, b = stats.genpareto._get_support(c)
+            assert_equal(a, 0.)
+            assert_(np.isposinf(b))
+
+        # c < 0: a=0, b=1/|c|
+        c = np.asarray(-2.)
+        a, b = stats.genpareto._get_support(c)
+        assert_allclose([a, b], [0., 0.5])
