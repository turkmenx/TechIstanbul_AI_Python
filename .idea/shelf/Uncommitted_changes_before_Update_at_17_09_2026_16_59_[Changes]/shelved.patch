+        if self.approx_type == 'hess':
+            w = delta_x
+            z = delta_grad
+        else:
+            w = delta_grad
+            z = delta_x
+        # Do some common operations
+        Mw = self @ w
+        z_minus_Mw = z - Mw
+        denominator = np.dot(w, z_minus_Mw)
